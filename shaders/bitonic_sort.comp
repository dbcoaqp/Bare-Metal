#version 460
layout(local_size_x = 256) in;

struct SortKeyPair {
    float depth;
    uint index;
};

layout(std430, binding = 1) buffer SortKeyBuffer {
    SortKeyPair sortKeys[];
};

layout(push_constant) uniform PushConstants {
    uint k;
    uint j;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint ixj = i ^ pc.j;

    if (ixj > i && ixj < sortKeys.length()) {
        float depth1 = sortKeys[i].depth;
        float depth2 = sortKeys[ixj].depth;

        bool swap = false;
        if ((i & pc.k) == 0) {
            if (depth1 < depth2) swap = true;
        } else {
            if (depth1 > depth2) swap = true;
        }

        if (swap) {
            SortKeyPair temp = sortKeys[i];
            sortKeys[i] = sortKeys[ixj];
            sortKeys[ixj] = temp;
        }
    }
}
