#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 256) in;
struct TileSortKeyPair { uint64_t key; uint index; };
layout(std430, binding = 10) readonly buffer TileSrcBuffer { TileSortKeyPair src[]; };
layout(std430, binding = 12) buffer TileHistogramBuffer { uint histogram[]; };
layout(push_constant) uniform PushConstants { uint shift; uint _pad1; uint _pad2; } pc;
shared uint localHist[256];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wgId = gl_WorkGroupID.x;

    localHist[tid] = 0;
    barrier();

    // Remove the .length() limit!
    uint bucket = uint((src[gid].key >> pc.shift) & 0xFFu);
    atomicAdd(localHist[bucket], 1u);
    barrier();

    histogram[wgId * 256 + tid] = localHist[tid];
}