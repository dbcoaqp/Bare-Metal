#version 460
layout(local_size_x = 256) in;

struct SortKeyPair {
    uint key;
    uint index;
};

layout(std430, binding = 1) readonly buffer SrcBuffer {
    SortKeyPair src[];
};

layout(std430, binding = 6) buffer HistogramBuffer {
    uint histogram[];
};

layout(push_constant) uniform PushConstants {
    uint shift;
    uint _pad1;
    uint _pad2;
} pc;

shared uint localHist[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wgId = gl_WorkGroupID.x;

    // Initialize shared memory histogram to zero
    localHist[tid] = 0;
    barrier();

    // Each thread reads its element and atomically increments the bucket counter
    if (gid < src.length()) {
        uint bucket = (src[gid].key >> pc.shift) & 0xFFu;
        atomicAdd(localHist[bucket], 1u);
    }
    barrier();

    // Write this workgroup's local histogram to the global buffer
    // Layout: histogram[workgroupID * 256 + bucket]
    histogram[wgId * 256 + tid] = localHist[tid];
}
