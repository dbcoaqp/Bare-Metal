#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 256) in;
struct TileSortKeyPair { uint64_t key; uint index; };
layout(std430, binding = 10) readonly buffer TileSrcBuffer { TileSortKeyPair src[]; };
layout(std430, binding = 11) buffer TileDstBuffer { TileSortKeyPair dst[]; };
layout(std430, binding = 12) readonly buffer TileHistogramBuffer { uint histogram[]; };
layout(std430, binding = 13) readonly buffer TileOffsetBuffer { uint offsets[]; };
layout(push_constant) uniform PushConstants { uint shift; uint _pad1; uint _pad2; } pc;
shared uint wgBaseOffset[256];
shared uint sharedBuckets[256];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wgId = gl_WorkGroupID.x;
    
    wgBaseOffset[tid] = offsets[tid] + histogram[wgId * 256 + tid];
    barrier();

    // Remove the .length() limit!
    sharedBuckets[tid] = uint((src[gid].key >> pc.shift) & 0xFFu);
    barrier();

    uint myBucket = sharedBuckets[tid];
    uint localRank = 0;
    for (uint i = 0; i < tid; i++) {
        if (sharedBuckets[i] == myBucket) localRank++;
    }
    dst[wgBaseOffset[myBucket] + localRank] = src[gid];
}