#version 460
layout(local_size_x = 256) in;

struct GaussianPoint {
    vec3 position; float opacity;
    vec3 scale;    float pad1;
    vec3 color;    float pad2;
    vec4 rot;
};

struct SortKeyPair {
    uint key;
    uint index;
};

struct Gaussian2D {
    vec2 pos2D;
    float depth;
    float opacity;
    vec3 conic;
    float pad1;
    vec3 color;
    uint bounds[4];     // min_tx, min_ty, max_tx, max_ty
    float pad2;
};

layout(std430, binding = 0) readonly buffer GaussianBuffer {
    GaussianPoint gaussians[];
};

layout(std430, binding = 1) readonly buffer SortKeyBuffer {
    SortKeyPair sortKeys[];
};

layout(std140, binding = 2) uniform CameraUBO {
    mat4 viewProj;
    vec4 cameraPosition;
    vec4 cameraForward;
    float focal_x;
    float focal_y;
    float tan_fovx;
    float tan_fovy;
    vec2 viewport;
    float filterDilation;
    float scaleModifier;
};

layout(std430, binding = 3) buffer Gaussian2DBuffer {
    Gaussian2D gaussians2D[];
};

// Phase 13: Touched tiles output buffer
layout(std430, binding = 8) buffer TouchedTilesBuffer {
    uint touchedTiles[];
};

// Phase 19b: Tile prefix sum buffer (reuse last element for atomic visible count)
layout(std430, binding = 9) buffer TilePrefixSumBuffer {
    uint tilePrefixSum[];
};

// Build rotation matrix from quaternion (w, x, y, z)
mat3 buildRotationMatrix(vec4 q) {
    float w = q.x, x = q.y, y = q.z, z = q.w;
    float x2 = x * x, y2 = y * y, z2 = z * z;
    float xy = x * y, xz = x * z, yz = y * z;
    float wx = w * x, wy = w * y, wz = w * z;

    return mat3(
        1.0 - 2.0 * (y2 + z2), 2.0 * (xy + wz),      2.0 * (xz - wy),
        2.0 * (xy - wz),        1.0 - 2.0 * (x2 + z2), 2.0 * (yz + wx),
        2.0 * (xz + wy),        2.0 * (yz - wx),        1.0 - 2.0 * (x2 + y2)
    );
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= sortKeys.length()) return;

    uint srcIdx = sortKeys[idx].index;

    // Skip padding elements (filled with 0xFFFFFFFF during radix sort init)
    if (srcIdx >= gaussians.length()) return;

    GaussianPoint gp = gaussians[srcIdx];

    // Recompute depth from position (stored as sortable uint key, not raw float)
    float depth = dot(gp.position - cameraPosition.xyz, cameraForward.xyz);

    // 1. Transform to clip space
    vec4 p_world = vec4(gp.position, 1.0);
    vec4 p_hom = viewProj * p_world;

    // 2. Behind camera check
    if (p_hom.w <= 0.2) {
        gaussians2D[idx].pos2D = vec2(1e10, 1e10);
        gaussians2D[idx].depth = depth;
        gaussians2D[idx].opacity = 0.0;
        gaussians2D[idx].conic = vec3(0.0);
        gaussians2D[idx].pad1 = 0.0;
        gaussians2D[idx].color = vec3(0.0);
        gaussians2D[idx].bounds[0] = 0u;
        gaussians2D[idx].bounds[1] = 0u;
        gaussians2D[idx].bounds[2] = 0u;
        gaussians2D[idx].bounds[3] = 0u;
        gaussians2D[idx].pad2 = 0.0;
        touchedTiles[idx] = 0u;
        return;
    }

    // 3. NDC and screen pixel coordinates
    vec3 p_ndc = p_hom.xyz / p_hom.w;
    vec2 pos2D = (p_ndc.xy * 0.5 + 0.5) * viewport;

    // 4. Build 3D rotation matrix and extract uniform scale
    mat3 R = buildRotationMatrix(gp.rot);
    mat3 S = mat3(gp.scale.x * scaleModifier, 0.0, 0.0,
                  0.0, gp.scale.y * scaleModifier, 0.0,
                  0.0, 0.0, gp.scale.z * scaleModifier);
    mat3 M = R * S; 


    // 5. Compute the Jacobian of the full viewProj -> screen transformation
    //    This directly computes T = J * W (projection Jacobian * view rotation)
    //    d(screen)/d(world_i) using quotient rule on perspective divide
    float invW = 1.0 / p_hom.w;
    float invW2 = invW * invW;

    vec3 dclipX = vec3(viewProj[0].x, viewProj[1].x, viewProj[2].x);
    vec3 dclipY = vec3(viewProj[0].y, viewProj[1].y, viewProj[2].y);
    vec3 dclipW = vec3(viewProj[0].w, viewProj[1].w, viewProj[2].w);

    vec3 jacobianRow0 = viewport.x * 0.5 * (dclipX * p_hom.w - p_hom.x * dclipW) * invW2;
    vec3 jacobianRow1 = viewport.y * 0.5 * (dclipY * p_hom.w - p_hom.y * dclipW) * invW2;

    // 6. Compute 2D covariance: Σ' = T * Σ_3d * T^T
    //    Σ_3d = R * S² * R^T, so we compute v_i = S * R^T * T[i]
    //    Then Σ'[i][j] = dot(v_i, v_j)
    // vec3 v0 = s * (transpose(R) * jacobianRow0);
    // vec3 v1 = s * (transpose(R) * jacobianRow1);

    
    vec3 v0 = jacobianRow0 * M;
    vec3 v1 = jacobianRow1 * M;

    float sigma_xx = dot(v0, v0) + filterDilation;
    float sigma_xy = dot(v0, v1);
    float sigma_yy = dot(v1, v1) + filterDilation;

    // ============================================================
    // Phase 13: Compute 2D ellipse pixel radius from eigenvalues
    // ============================================================
    float det_cov = sigma_xx * sigma_yy - sigma_xy * sigma_xy;
    float mid = 0.5 * (sigma_xx + sigma_yy);
    float discriminant = mid * mid - det_cov;
    float lambda1 = mid + sqrt(max(0.1, discriminant));
    float lambda2 = mid - sqrt(max(0.1, discriminant));
    float radius = ceil(3.0 * sqrt(max(lambda1, lambda2)));

    // Pixel bounding box
    vec2 minPixel = pos2D - vec2(radius);
    vec2 maxPixel = pos2D + vec2(radius);

    // Convert to tile grid coordinates (tile size = 16 pixels, floor division)
    float tileMaxX = viewport.x / 16.0;
    float tileMaxY = viewport.y / 16.0;

    uint min_tx = uint(clamp(floor(minPixel.x / 16.0), 0.0, tileMaxX));
    uint min_ty = uint(clamp(floor(minPixel.y / 16.0), 0.0, tileMaxY));
    uint max_tx = uint(clamp(ceil(maxPixel.x / 16.0), 0.0, tileMaxX));
    uint max_ty = uint(clamp(ceil(maxPixel.y / 16.0), 0.0, tileMaxY));

    // 7. Invert 2D covariance to get conic (a, b, c)
    float det = sigma_xx * sigma_yy - sigma_xy * sigma_xy;

    vec3 conic;
    if (abs(det) > 1e-7) {
        float invDet = 1.0 / det;
        conic.x = sigma_yy * invDet;
        conic.y = -sigma_xy * invDet;
        conic.z = sigma_xx * invDet;
    } else {
        conic = vec3(1.0, 0.0, 1.0); // degenerate fallback
    }

    // 8. Write output (indexed by sorted order)
    gaussians2D[idx].pos2D = pos2D;
    gaussians2D[idx].depth = depth;
    gaussians2D[idx].opacity = gp.opacity;
    gaussians2D[idx].conic = conic;
    gaussians2D[idx].pad1 = 0.0;
    gaussians2D[idx].color = gp.color;
    gaussians2D[idx].bounds[0] = min_tx;
    gaussians2D[idx].bounds[1] = min_ty;
    gaussians2D[idx].bounds[2] = max_tx;
    gaussians2D[idx].bounds[3] = max_ty;
    gaussians2D[idx].pad2 = 0.0;

    // Phase 13: Write touched tile count
    uint touchedCount = (max_tx - min_tx) * (max_ty - min_ty);
    touchedTiles[idx] = touchedCount;

    // Phase 19b: Atomically count visible Gaussians for HUD telemetry
    // Write to tilePrefixSum[paddedCount] (= sortKeys.length()) to avoid
    // altering the 15-binding descriptor layout.
    if (touchedCount > 0u) {
        atomicAdd(tilePrefixSum[sortKeys.length()], 1u);
    }
}
