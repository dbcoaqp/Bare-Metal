#version 460
layout(local_size_x = 256) in;
struct SortKeyPair { uint key; uint index; };
layout(std430, binding = 1) readonly buffer SrcBuffer { SortKeyPair src[]; };
layout(std430, binding = 5) buffer DstBuffer { SortKeyPair dst[]; };
layout(std430, binding = 6) readonly buffer HistogramBuffer { uint histogram[]; };
layout(std430, binding = 7) readonly buffer OffsetBuffer { uint offsets[]; };
layout(push_constant) uniform PushConstants { uint shift; uint _pad1; uint _pad2; } pc;
shared uint wgBaseOffset[256];
shared uint sharedBuckets[256];
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint wgId = gl_WorkGroupID.x;

    wgBaseOffset[tid] = offsets[tid] + histogram[wgId * 256 + tid];
    barrier();

    // Remove the .length() limit!
    sharedBuckets[tid] = (src[gid].key >> pc.shift) & 0xFFu;
    barrier();

    uint myBucket = sharedBuckets[tid];
    uint localRank = 0;
    for (uint i = 0; i < tid; i++) {
        if (sharedBuckets[i] == myBucket) localRank++;
    }
    dst[wgBaseOffset[myBucket] + localRank] = src[gid];
}