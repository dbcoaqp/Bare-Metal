#version 460

layout (local_size_x = 256) in;

struct GaussianPoint {
    vec3 position;
    float scale;
    vec3 color;
    float opacity;
    vec4 rot;
};

struct SortKeyPair {
    uint key;
    uint index;
};

layout(std430, binding = 0) readonly buffer GaussianBuffer {
    GaussianPoint gaussians[];
};

layout(std430, binding = 1) buffer SortKeyBuffer {
    SortKeyPair sortKeys[];
};

layout(std140, binding = 2) uniform CameraUBO {
    mat4 viewProj;
    vec4 cameraPosition;
    vec4 cameraForward;
    float focal_x;
    float focal_y;
    float tan_fovx;
    float tan_fovy;
    vec2 viewport;
    vec2 pad_cam;
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    
    // Guard against out-of-bounds access
    if (index >= gaussians.length()) return;
    
    vec3 pos = gaussians[index].position;
    float depth = dot(pos - cameraPosition.xyz, cameraForward.xyz);
    
    // IEEE 754 float-to-sortable-uint transformation for ascending depth order
    uint depthKey = floatBitsToUint(depth);
    // Negative (sign bit=1): flip all bits; Positive (sign bit=0): flip sign bit
    depthKey = (depthKey & 0x80000000u) == 0u ? (~depthKey) : (depthKey ^ 0x80000000u);
    
    sortKeys[index].key = depthKey;
    sortKeys[index].index = index;
}
